{
  "name": "open-stuttgart",
  "license": "EUPL-1.2",
  "version": "0.1.0",
  "private": true,
  "description": "Open Stuttgart: offene Daten der Landeshauptstadt und der Region auf einer Karte (nicht kommerzielles Open-Source-Projekt)",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "npm run build && node server/index.mjs",
    "serve": "node server/index.mjs",
    "data:gtfs": "python3 scripts/build_gtfs.py",
    "data:verwaltung": "node scripts/crawl-verwaltung.mjs",
    "data:unfall": "node scripts/build-unfaelle.mjs",
    "data:wanderwege": "node scripts/build-wanderwege.mjs",
    "data:geocaches": "node scripts/build-geocaches.mjs",
    "data:search": "node scripts/build-search-db.mjs",
    "check:wasgeht": "node scripts/check-wasgeht-quellen.mjs",
    "check:bot": "node scripts/bot-eval.mjs"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/merriweather-sans": "^5.3.0",
    "maplibre-gl": "^6.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
